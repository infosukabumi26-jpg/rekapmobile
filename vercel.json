{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/contoh_csv/(.*)",
      "dest": "/contoh_csv/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

